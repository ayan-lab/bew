{
  "include": ["./**/*"],
  "exclude": ["node_modules", "migrations"],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
